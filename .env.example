# Copiază acest fișier ca `.env` și completează valorile.
# Fișierul `.env` NU se publică în Git (conține chei și parole).

# Cheie secretă Django (obligatorie). Generare:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=schimba-ma

# True doar pe calculatorul dezvoltatorului
DEBUG=True

# Domeniile de pe care răspunde aplicația (separate prin virgulă)
ALLOWED_HOSTS=localhost,127.0.0.1

# Baza de date PostgreSQL (obligatorie). Pornire: docker compose up -d db
# Baza de DEZVOLTARE (aprovizionare_dev); baza „aprovizionare” e a aplicației din Docker.
DATABASE_URL=postgres://aprovizionare:aprovizionare@127.0.0.1:5433/aprovizionare_dev

# Email. Local: Mailpit (docker compose up -d mailpit), emailurile se văd la
# http://localhost:8025 și nu pleacă nicăieri. Dacă lipsește, se afișează în terminal.
EMAIL_URL=smtp://127.0.0.1:1025

# Adresa aplicației, folosită în link-urile din emailuri
SITE_URL=http://127.0.0.1:8000

# Toleranța de preț la potrivirea facturilor, în procente
PRICE_TOLERANCE_PERCENT=0

# Ora (0-23) la care pleacă rezumatul zilnic pe email
NOTIFICATION_HOUR=8

# Adresa fișierelor cu cursurile BNR (implicit https://curs.bnr.ro)
# BNR_BASE_URL=https://curs.bnr.ro

# seed_demo --reset (șterge TOATĂ baza de date și regenerează datele demo).
# Doar pe calculatorul dezvoltatorului sau pe un server de demonstrație, NICIODATĂ în producție.
# DEMO_RESET_ALLOWED=True
